# Run: python scripts/setup_local.py (creates .env with a random session key).
# These defaults are for the PC. For Vercel use APP_MODE=VERCEL, PostgreSQL,
# COOKIE_SECURE=true and your exact hosted ALLOWED_HOSTS. See docs/deploy-to-vercel.md.
APP_MODE=PC
DATABASE_URL=sqlite:///./var/lead-desk.sqlite
DATA_DIR=./var
SESSION_SECRET=
COOKIE_SECURE=false
ALLOWED_HOSTS=["127.0.0.1","localhost","testserver"]
WORKSPACE_NAME=Webix Lead Desk
DISPLAY_TIMEZONE=Asia/Karachi
SENDING_TIMEZONE=America/Edmonton
PREVIEW_ENABLED=true
# Live sending requires the dedicated worker and owner readiness checks.
# The legacy broad external integration switch remains unsupported.
LIVE_SEND_ENABLED=false
EXTERNAL_INTEGRATIONS_ENABLED=false
WORKER_POLL_SECONDS=2
WORKER_LEASE_SECONDS=30
JOB_LEASE_SECONDS=60
SESSION_HOURS=8
LOGIN_WINDOW_SECONDS=900
LOGIN_ATTEMPT_LIMIT=8
IP_LOGIN_ATTEMPT_LIMIT=30


# Optional AI; never enable until API funding and current model rates are verified.
OPENAI_ENABLED=false
OPENAI_API_KEY=
# Model access must be verified in the linked API organization.
OPENAI_AUDIT_MODEL=gpt-6-luna
OPENAI_DRAFT_MODEL=gpt-6.1-sol
# USD millionths per million tokens: enter current STANDARD input/output rates.
# Zero rates block AI. No price is hardcoded.
OPENAI_AUDIT_INPUT_USD_MICRO_PER_MILLION=0
OPENAI_AUDIT_OUTPUT_USD_MICRO_PER_MILLION=0
OPENAI_DRAFT_INPUT_USD_MICRO_PER_MILLION=0
OPENAI_DRAFT_OUTPUT_USD_MICRO_PER_MILLION=0
OPENAI_MAX_OUTPUT_TOKENS=1500
# Optional overnight audits only. Draft generation always uses synchronous Responses.
OPENAI_PROCESSING=standard
# Claimed subscription credits can fund the API; record actual balance and expiry in Settings.
# Manual copyable ChatGPT briefs work while OPENAI_ENABLED=false.
# Mailbox identities and encrypted Titan/Hostinger/Gmail credentials are saved in Settings.

# One dedicated Fernet key shared privately by the web app and PC/VPS worker.
ENCRYPTION_KEY=
# Keep false until sender readiness and owner-approved test acceptance are complete.
# Never enable delivery in the Vercel web process.
# SMTP/IMAP endpoints and limits belong to each mailbox in Settings.
MAIL_TIMEOUT_SECONDS=30

# HTTPS origin used only after explicit concept-publication approval.
PUBLIC_BASE_URL=

# Separate authenticated backup key; keep a recovery copy outside the database.
BACKUP_KEY=
BACKUP_MAX_BYTES=100000000

# Responses web search has a separate bounded result size. Prices and quotas are
# entered in Settings → Lead discovery; zero prices/caps block billable searches.
OPENAI_SEARCH_MAX_OUTPUT_TOKENS=6000
# Optional Google Places key is encrypted through Settings, never pasted in chat.
